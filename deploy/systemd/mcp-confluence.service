# systemd unit: /etc/systemd/system/mcp-confluence.service
#   systemctl daemon-reload && systemctl enable --now mcp-confluence
[Unit]
Description=MCP server mcp-confluence (behind the MCP gateway, mTLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
# Secrets and addresses (mcp-confluence.env.template); logs go to journald.
EnvironmentFile=/etc/mcp-confluence/mcp-confluence.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -jar /opt/mcp-confluence/mcp-confluence.jar

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# The JIT needs writable and executable memory.
MemoryDenyWriteExecute=false
ReadOnlyPaths=/etc/mcp-confluence /opt/mcp-confluence
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
