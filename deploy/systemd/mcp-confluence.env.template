# Environment of the mcp-confluence service: copy to /etc/mcp-confluence/mcp-confluence.env (root:mcp, 0640).
# The real file is never committed. Prefer rendering it from the secrets store at deploy time.
# No backend credential here: the gateway sends the user's credential with every call (C3).

# mTLS: this server's certificate (CN mcp-confluence, SAN mcp-confluence.internal, server and client use) and the internal CA, both PKCS12.
MCP_TLS_KEYSTORE=/etc/mcp-confluence/tls/keystore.p12
MCP_TLS_TRUSTSTORE=/etc/mcp-confluence/tls/truststore.p12
MCP_TLS_STORE_PASSWORD=

# Gateway: JWKS of the internal JWT (C2), served over TLS signed by the internal CA.
MCP_GATEWAY_JWKS_URI=https://mcp-gateway.internal:8443/.well-known/jwks.json

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# Backend system API (with the context path if Confluence has one, for example https://HOST/confluence);
# MCP_CONFLUENCE_SSL_BUNDLE only when it needs a non-default trust store.
MCP_CONFLUENCE_URL=
# Writes are on for Confluence 8.5 up to 10.x. Set to true only to allow them on a release the probe does not know.
MCP_CONFLUENCE_WRITES_ON_UNKNOWN_VERSION=false

# HMAC key of list cursors: Base64 of at least 32 random bytes (openssl rand -base64 32). The same on every instance.
MCP_CURSOR_KEY=

# Redis for one-time jti (ACL user mcp-confluence, keys jti:mcp-confluence:*, command SET).
MCP_REDIS_HOST=
MCP_REDIS_PORT=6379
MCP_REDIS_USER=mcp-confluence
MCP_REDIS_PASSWORD=

# Policy data (scope mapping, allowed AI clients, emergency overrides) of the gateway, fetched over mTLS with this server's
# own certificate (the gateway reads the server id from its CN). The policies themselves are in the jar.
MCP_GATEWAY_POLICY_DATA_URL=https://mcp-gateway.internal:8443/internal/v1/policy-data
# Only when the host in the URL is not a name in the gateway certificate:
# MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# Registration data of the manifest (GET /mcp-manifest): the address the gateway reaches this server at.
MCP_INTERNAL_URL=https://mcp-confluence.internal:8443/mcp
MCP_ACCEPTED_CREDENTIAL_TYPES=user-secret
